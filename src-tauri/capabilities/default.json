{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the CU Desktop main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://seeyoumore.ru/_serverFn/**"
        }
      ]
    }
  ]
}
